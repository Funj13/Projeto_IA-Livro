# ==============================================================================
# EstudaIA — Variáveis de Ambiente
# ==============================================================================
# ATENÇÃO: Nunca adicione chaves de API reais neste arquivo nem o envie ao git.
# Nunca utilize o prefixo NEXT_PUBLIC_ para chaves de API para não expô-las no frontend.

# Chave de API da IA (Google AI Studio / Gemini)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo padrão de IA
GEMINI_MODEL=gemini-1.5-flash

# Provedor de IA ativo ('mock' para testes/desenvolvimento ou 'gemini')
AI_PROVIDER=mock
